# Copia este archivo como .env para probar el asistente en tu computadora. Nunca subas .env al repositorio.
# En Render estas variables se escriben en el panel del servicio herbolario-api.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_EFFORT=low
ALLOWED_ORIGINS=http://localhost:8765
TOTAL_POR_DIA=1500
PORT=8000
